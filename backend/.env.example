# 环境配置
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Kmap Backend
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
SECRET_KEY=your-secret-key-here-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=1

# PostgreSQL 配置
DATABASE_URL=postgresql://kmap:kmap123@localhost:5432/kmap
DATABASE_SCHEMA=public

# Redis 配置
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100

# Qdrant 向量数据库配置
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant123
QDRANT_COLLECTION_PREFIX=kmap_
QDRANT_VECTOR_SIZE=1536

# Nebula Graph 图数据库配置
NEBULA_GRAPH_HOST=localhost
NEBULA_GRAPH_PORT=9669
NEBULA_GRAPH_USER=root
NEBULA_GRAPH_PASSWORD=nebula
NEBULA_GRAPH_SPACE=kmap
NEBULA_GRAPH_TIMEOUT=30000

# RabbitMQ 消息队列配置
RABBITMQ_URL=amqp://kmap:kmap123@localhost:5672//
RABBITMQ_EXCHANGE=kmap_exchange
RABBITMQ_QUEUE_PREFIX=kmap_

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# 上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=["txt", "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "md", "json", "csv"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# 安全配置
PASSWORD_MIN_LENGTH=8
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
